        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analizza questi log e genera un report giornaliero in italiano. Log: {{ $json.log_text }} Totale: {{ $json.totale_record }} esecuzioni. Includi: totale esecuzioni, successi/errori, workflow attivi, stato sistema.\"\n    }\n  ]\n}",
