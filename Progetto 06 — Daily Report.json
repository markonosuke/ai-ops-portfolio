    {
      "parameters": {
        "jsCode": "const records = items.map(item => item.json);\n\nconst riassunto = records.map(r =>\n  `[${r.timestamp}] ${r.workflow} - ${r.esito} - ${r.documento} - ${r.dettaglio}`\n).join(' ||| ');\n\nreturn [{\n  json: {\n    log_text: riassunto,\n    totale_record: records.length\n  }\n}];;"
      },
