jsCode	"const raw = $input.first().json.data;\n\nconst cleaned = raw\n  .replace(/\\/\\*.*?\\*\\//g, '')\n  .replace(/^[^(]+\\(/, '')\n  .replace(/\\);?\\s*$/, '')\n  .trim();\n\nconst data = JSON.parse(cleaned);\nconst rows = data.table.rows;\n\n// Salta la prima riga (intestazione)\nconst dataRows = rows.slice(1);\n\n// Assegniamo noi i nomi delle colonne per posizione\nconst nomiColonne = ['NumeroDoc', 'Titolo', 'Tipo', 'Revisione', 'Stato', 'Responsabile'];\n\nconst result = dataRows.map(row => {\n  const obj = {};\n  nomiColonne.forEach((nome, i) => {\n    obj[nome] = (row.c[i]?.v ?? '').toString().trim();\n  });\n  return { json: obj };\n});\n\nreturn result;"
