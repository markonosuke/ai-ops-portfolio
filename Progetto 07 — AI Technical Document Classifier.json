        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 200,\n  \"temperature\": 0,\n  \"system\": \"You are a technical document classifier specialized in industrial engineering. Your task is to analyze technical documents and return a structured JSON object. Always respond with valid JSON only. No explanations, no markdown, no extra text.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze the following technical document and return this exact JSON structure:\\n\\n{\\\"document_type\\\": \\\"P&ID\\\" | \\\"MANUAL\\\" | \\\"SPEC\\\" | \\\"REPORT\\\" | \\\"OTHER\\\", \\\"confidence\\\": \\\"high\\\" | \\\"medium\\\" | \\\"low\\\", \\\"language\\\": \\\"IT\\\" | \\\"EN\\\" | \\\"DE\\\" | \\\"FR\\\" | \\\"OTHER\\\", \\\"keywords\\\": [\\\"keyword1\\\", \\\"keyword2\\\", \\\"keyword3\\\"], \\\"summary\\\": \\\"max 2 sentences describing the document content\\\"}\\n\\nDocument:\\n{{ $json.document_text }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
