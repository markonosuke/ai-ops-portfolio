    },
    {
      "parameters": {
        "jsCode": "// Input = risposta di Claude (1 item)\nlet testo = $json.content[0].text;\n\n// Tolgo l'involucro ```json ... ``` che Claude aggiunge spesso\ntesto = testo.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Trasformo la stringa in oggetto vero\nconst validazione = JSON.parse(testo);\n\nreturn validazione;"
      },
      "type": "n8n-nodes-base.code",
