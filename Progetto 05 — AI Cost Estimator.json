        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Sei un preventivista esperto di officina metalmeccanica. Ricevi la descrizione di un pezzo e devi calcolare un preventivo realistico.\\n\\nDati pezzo:\\n- Tipo: {{ $json.body.tipo }}\\n- Materiale: {{ $json.body.materiale }}\\n- Dimensioni: {{ $json.body.dimensioni }}\\n- Spessore: {{ $json.body.spessore }}\\n- Quantità: {{ $json.body.quantita }}\\n\\nCalcola e rispondi SOLO con questo JSON, senza altro testo:\\n{\\n  \\\"materiale_grezzo_kg\\\": numero,\\n  \\\"bulloni_quantita\\\": numero,\\n  \\\"ore_lavorazione\\\": numero,\\n  \\\"costo_materiale_eur\\\": numero,\\n  \\\"costo_manodopera_eur\\\": numero,\\n  \\\"costo_totale_eur\\\": numero,\\n  \\\"note\\\": \\\"breve nota tecnica\\\"\\n}\\n\\nUsa questi prezzi di riferimento:\\n- Lamiera acciaio: 1.20 €/kg\\n- Lamiera inox: 4.50 €/kg\\n- Profilati: 1.50 €/kg\\n- Bulloneria: 0.30 €/pz\\n- Manodopera: 35 €/ora\"\n    }\n  ]\n}",
        "options": {}
      },
