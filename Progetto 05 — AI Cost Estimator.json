    {
      "parameters": {
        "jsCode": "const risposta = items[0].json;\nlet testo = risposta.content[0].text;\n\n// Pulisce eventuali backtick markdown\ntesto = testo.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n\nconst preventivo = JSON.parse(testo);\n\nreturn [{\n  json: preventivo\n}];"
      },
